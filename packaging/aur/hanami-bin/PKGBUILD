# Maintainer: sjdsjadjajdjsa <https://github.com/sjdsjadjajdjsa>
pkgname=hanami-bin
_pkgname=hanami
pkgver=0.2.5
pkgrel=1
pkgdesc="Game launcher in the tray: a small panel that lists your installed games"
arch=('x86_64')
url="https://hanami.lilygrove.dev"
license=('GPL-3.0-or-later')
depends=('libgcc' 'glibc' 'fontconfig' 'hicolor-icon-theme' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcursor' 'libxi' 'systemd-libs')
optdepends=('wayland: Wayland sessions'
            'steam: find Steam games'
            'lutris: find Lutris games'
            'heroic-games-launcher-bin: find Epic, GOG and Amazon games')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname-$pkgver-linux-x86_64.tar.gz::https://github.com/sjdsjadjajdjsa/hanami/releases/download/v$pkgver/hanami-linux-x86_64.tar.gz"
        "$_pkgname-$pkgver.svg::https://raw.githubusercontent.com/sjdsjadjajdjsa/hanami/v$pkgver/assets/hanami-icon.svg"
        "$_pkgname.desktop")
sha256sums=('62ccab576c01c43e18151d10cd1cd23e62d65bfdf51d9fffdb65b92821c228e1'
            'd506fce091d95b5e747c2c4a6eae36a2c2fbf085e4923a05f8bca042240c0384'
            '27cb082f89105156905613696228a5d77c1c165279698929f37ce5500f418dcc')

package() {
    install -Dm755 "$srcdir/$_pkgname/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 "$srcdir/$_pkgname-$pkgver.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
    install -Dm644 "$srcdir/$_pkgname/README.md" "$srcdir/$_pkgname/GUIDE.md" -t "$pkgdir/usr/share/doc/$pkgname"
    install -Dm644 "$srcdir/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

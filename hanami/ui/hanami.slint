import "../../assets/Inter-Regular.ttf";
import "../../assets/Inter-Medium.ttf";
import "../../assets/Inter-SemiBold.ttf";

export struct Petal {
    x: float,
    speed: float,
    sway: float,
    freq: float,
    spin: float,
    size: float,
    alpha: float,
    phase: float,
    // Where in its fall it starts, 0 to 1; spread out so petals don't bunch.
    drop: float,
    // How fast it turns over, showing its edge.
    flip: float,
    // Transparent keeps the picture's own colours.
    tint: color,
    // The picture painted in the tint; empty means the panel's own petal.
    image: image,
}

export struct GameRow {
    name: string,
    label: string,
    icon: image,
    initial: string,
    pinned: bool,
    new: bool,
    // A launcher row: Enter shows the games listed under it.
    opens: bool,
}

// Every colour, size and gap comes from here (see DESIGN.md). The colours
// are set from the settings' [theme]; the rest is fixed.
export global Tokens {
    in-out property <color> panel: #17141db8;
    out property <color> edge: #ffffff17;
    in-out property <color> text: #ece6ee;
    in-out property <color> dim: #9b93a3;
    in-out property <color> accent: #f4b6c8;
    out property <color> pick: self.accent.with-alpha(0.14);
    out property <color> select: self.accent.with-alpha(0.35);
    out property <color> hover: #ffffff0d;
    out property <length> pad: 20px;
    out property <length> gap: 8px;
    out property <length> inset: 14px;
    out property <length> radius: 16px;
    out property <length> row-radius: 10px;
    out property <length> row-height: 44px;
    out property <length> row-step: self.row-height + self.gap;
    out property <length> icon-size: 24px;
    out property <length> icon-radius: 6px;
    out property <length> chip-height: 32px;
    out property <length> chip-radius: 8px;
    out property <length> title-size: 15px;
    out property <length> name-size: 14px;
    out property <length> small-size: 11px;
}

component PetalView inherits Image {
    in property <Petal> p;
    in property <length> area-w;
    in property <length> area-h;
    in property <float> t;
    in property <image> shape;
    source: p.image.width > 0 ? p.image : shape;
    // Its own shape, squeezed sideways as it turns over.
    image-fit: fill;
    height: p.size * 1.2px;
    width: self.height * self.source.width / Math.max(1, self.source.height)
        * (0.65 + 0.35 * Math.abs(Math.cos((t * p.flip + p.phase * 31) * 1rad)));
    opacity: p.alpha;
    x: area-w * p.x + p.sway * 1px * Math.sin((t * p.freq + p.phase) * 1rad) - self.width / 2;
    y: Math.mod(t * p.speed + p.drop * (area-h / 1px + 40), area-h / 1px + 40) * 1px - 20px;
    transform-rotation: (t * p.spin + p.phase * 57) * 1deg;
}

// A speck of the accent colour drifting up, like pollen or an ember.
component DotView inherits Rectangle {
    in property <Petal> p;
    in property <length> area-w;
    in property <length> area-h;
    in property <float> t;
    width: p.size * 1px;
    height: self.width;
    border-radius: self.width / 2;
    background: Tokens.accent;
    opacity: p.alpha * (0.55 + 0.45 * Math.sin((t * 2.1 + p.phase) * 1rad));
    x: area-w * p.x + p.sway * 1px * Math.sin((t * p.freq + p.phase) * 1rad) - self.width / 2;
    y: area-h - Math.mod(t * p.speed + p.phase * 97, area-h / 1px + 20) * 1px + 10px;
}

// A small text button: row actions and the new-games prompt.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    in property <length> font-size: Tokens.name-size;
    callback clicked();
    height: Tokens.chip-height;
    border-radius: Tokens.chip-radius;
    background: lit ? Tokens.pick : touch.has-hover ? Tokens.hover : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: 500;
            color: root.lit ? Tokens.accent : Tokens.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "+" and "?" in the header.
component Round inherits Rectangle {
    in property <string> text;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: self.height / 2;
    background: touch.has-hover ? Tokens.hover : transparent;
    animate background { duration: 120ms; }
    Text {
        text: root.text;
        font-size: Tokens.small-size;
        font-weight: 600;
        color: touch.has-hover ? Tokens.text : Tokens.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Icon inherits Rectangle {
    in property <GameRow> game;
    width: Tokens.icon-size;
    height: Tokens.icon-size;
    border-radius: Tokens.icon-radius;
    clip: true;
    background: game.icon.width > 0 ? transparent : Tokens.hover;
    Image {
        width: parent.width;
        height: parent.height;
        source: game.icon;
        image-fit: contain;
    }
    if game.icon.width == 0: Text {
        text: game.initial;
        font-size: Tokens.small-size;
        font-weight: 600;
        color: Tokens.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Row inherits Rectangle {
    in property <GameRow> game;
    in property <bool> picked;
    in property <bool> acting;
    in property <int> action;
    in property <bool> renaming;
    callback activate();
    callback point();
    callback more();
    callback act(int);
    callback renamed(string);
    height: Tokens.row-height;
    border-radius: Tokens.row-radius;
    background: (picked && !acting) || renaming ? Tokens.pick : area.has-hover && !acting ? Tokens.hover : transparent;
    animate background { duration: 120ms; }

    area := TouchArea {
        clicked => {
            if (!root.acting && !root.renaming) {
                root.activate();
            }
        }
        moved => { root.point(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.more();
            }
        }
    }

    if !acting: HorizontalLayout {
        padding-left: Tokens.inset - 4px;
        padding-right: Tokens.inset;
        padding-top: (Tokens.row-height - Tokens.icon-size) / 2;
        padding-bottom: (Tokens.row-height - Tokens.icon-size) / 2;
        spacing: 10px;
        Icon { game: root.game; }
        if !renaming: Text {
            text: game.name;
            font-size: Tokens.name-size;
            font-weight: 500;
            color: picked ? Tokens.accent : Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if renaming: TextInput {
            text: game.name;
            font-size: Tokens.name-size;
            font-weight: 500;
            color: Tokens.accent;
            selection-background-color: Tokens.select;
            selection-foreground-color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            single-line: true;
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.renamed(self.text); }
        }
        if !renaming: Text {
            text: game.label;
            font-size: Tokens.small-size;
            color: Tokens.dim;
            vertical-alignment: center;
        }
        if !renaming && game.opens: Text {
            text: "›";
            font-size: Tokens.name-size;
            color: picked ? Tokens.accent : Tokens.dim;
            vertical-alignment: center;
        }
    }

    if acting: HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: (Tokens.row-height - Tokens.chip-height) / 2;
        padding-bottom: (Tokens.row-height - Tokens.chip-height) / 2;
        spacing: 4px;
        alignment: start;
        Chip {
            text: game.new ? "Keep" : game.pinned ? "Unpin" : "Pin to top";
            lit: root.action == 0;
            clicked => { root.act(0); }
        }
        Chip {
            text: "Rename";
            lit: root.action == 1;
            clicked => { root.act(1); }
        }
        Chip {
            text: "Hide";
            lit: root.action == 2;
            clicked => { root.act(2); }
        }
    }
}

export component Panel inherits Window {
    in property <[Petal]> petals;
    in property <[Petal]> dots;
    // The petal's picture: the sakura petal unless the settings bring another.
    in property <image> petal: @image-url("../../assets/petal.svg");
    in property <[GameRow]> games;
    in property <int> total;
    in property <int> fresh;
    in property <string> query;
    // The open launcher row's name; empty on the whole list.
    in property <string> folder;
    in property <string> notice;
    in property <float> t;
    in property <bool> shown;
    in-out property <int> selected: 0;
    // The row showing its actions, and which action is highlighted.
    in-out property <int> acting: -1;
    in-out property <int> action: 0;
    in-out property <int> renaming: -1;

    callback launch(int);
    callback dismiss();
    callback back();
    callback typed(string);
    callback erased();
    callback ask-ai();
    callback add-game();
    callback pin(int);
    callback rename(int, string);
    callback hide-game(int);
    callback keep-new();
    callback hide-new();

    public function focus-keys() {
        keys.focus();
        list.content-y = 0;
    }

    title: "Hanami";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 340px;
    height: 440px;
    default-font-family: "Inter";

    // The selected row, or when the wheel has scrolled it out of view, the
    // row at the top of what is visible: the arrows carry on from there.
    function visible-selected() -> int {
        if (root.selected * Tokens.row-step + list.content-y < 0
            || (root.selected + 1) * Tokens.row-step - Tokens.gap + list.content-y > list.height) {
            return Math.clamp(Math.floor(-list.content-y / Tokens.row-step), 0, root.games.length - 1);
        }
        return root.selected;
    }

    function reveal() {
        if (root.selected * Tokens.row-step + list.content-y < 0) {
            list.content-y = -root.selected * Tokens.row-step;
        }
        if ((root.selected + 1) * Tokens.row-step - Tokens.gap + list.content-y > list.height) {
            list.content-y = list.height - (root.selected + 1) * Tokens.row-step + Tokens.gap;
        }
    }

    function act(row: int, which: int) {
        root.acting = -1;
        if (which == 0) {
            root.pin(row);
        } else if (which == 1) {
            root.selected = row;
            root.renaming = row;
        } else {
            root.hide-game(row);
        }
    }

    function more(row: int) {
        if (root.renaming >= 0) {
            return;
        }
        root.selected = row;
        root.acting = row;
        root.action = 0;
    }

    changed selected => {
        root.reveal();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.renaming >= 0) {
                    root.renaming = -1;
                    keys.focus();
                } else if (root.acting >= 0) {
                    root.acting = -1;
                } else if (root.folder != "") {
                    root.back();
                } else {
                    root.dismiss();
                }
                return accept;
            }
            // The name field takes what it needs; the rest must not move the list.
            if (root.renaming >= 0) {
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Menu) {
                if (root.acting >= 0) {
                    root.action = Math.mod(root.action + 1, 3);
                } else if (root.games.length > 0) {
                    root.more(root.selected);
                }
                return accept;
            }
            if (event.text == Key.Backtab) {
                if (root.acting >= 0) {
                    root.action = Math.mod(root.action + 2, 3);
                }
                return accept;
            }
            if (root.acting >= 0) {
                if (event.text == Key.RightArrow) {
                    root.action = Math.min(root.action + 1, 2);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.action = Math.max(root.action - 1, 0);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.act(root.acting, root.action);
                    return accept;
                }
                root.acting = -1;
            }
            if (event.text == Key.DownArrow) {
                if (root.games.length > 0) {
                    root.selected = Math.min(root.visible-selected() + 1, root.games.length - 1);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.selected = Math.max(root.visible-selected() - 1, 0);
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.games.length > 0) {
                    root.launch(root.selected);
                }
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.erased();
                return accept;
            }
            // AltGr arrives as Ctrl+Alt on Windows and types letters like @ or ł.
            if (event.modifiers.meta || event.modifiers.control != event.modifiers.alt) {
                return reject;
            }
            root.typed(event.text);
            accept
        }

        panel := Rectangle {
            opacity: root.shown ? 1 : 0;
            animate opacity { duration: 140ms; easing: ease-out; }
            border-radius: Tokens.radius;
            background: Tokens.panel;
            border-width: 1px;
            border-color: Tokens.edge;
            clip: true;

            for p in root.dots: DotView {
                p: p;
                area-w: panel.width;
                area-h: panel.height;
                t: root.t;
            }

            for p in root.petals: PetalView {
                p: p;
                shape: root.petal;
                area-w: panel.width;
                area-h: panel.height;
                t: root.t;
            }

            VerticalLayout {
                padding: Tokens.pad;
                spacing: Tokens.gap;

                HorizontalLayout {
                    padding-left: Tokens.inset;
                    padding-right: Tokens.inset;
                    padding-bottom: 6px;
                    spacing: 12px;
                    title := Text {
                        text: root.query != "" ? root.query : root.folder != "" ? "‹  " + root.folder : "hanami";
                        font-size: Tokens.title-size;
                        font-weight: root.query == "" ? 600 : 500;
                        color: root.folder != "" && back.has-hover ? Tokens.accent : Tokens.text;
                        horizontal-stretch: 1;
                        overflow: elide;
                        back := TouchArea {
                            enabled: root.folder != "";
                            mouse-cursor: root.folder != "" ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { root.back(); }
                        }
                    }
                    Text {
                        text: root.query != "" ? root.games.length + " of " + root.total
                            : root.folder == "" ? root.total + " games"
                            : root.total == 1 ? "1 instance" : root.total + " instances";
                        font-size: Tokens.small-size;
                        color: Tokens.dim;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        add := Round {
                            y: (parent.height - self.height) / 2;
                            text: "+";
                            clicked => { root.add-game(); }
                        }
                        // Copies a prompt that explains Hanami to the user's AI.
                        help := Round {
                            y: (parent.height - self.height) / 2;
                            text: "?";
                            clicked => { root.ask-ai(); }
                        }
                    }
                }

                if root.fresh > 0 && root.query == "" && root.folder == "": HorizontalLayout {
                    padding-left: Tokens.inset;
                    spacing: 4px;
                    Text {
                        text: root.fresh == 1 ? "Found a new game" : "Found " + root.fresh + " new games";
                        font-size: Tokens.small-size;
                        color: Tokens.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Chip {
                        text: "Keep";
                        font-size: Tokens.small-size;
                        clicked => { root.keep-new(); }
                    }
                    Chip {
                        text: "Hide";
                        font-size: Tokens.small-size;
                        clicked => { root.hide-new(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    list := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: Math.max(root.games.length * Tokens.row-step - Tokens.gap, 0px);
                        for game[i] in root.games: Row {
                            x: 0;
                            y: i * Tokens.row-step;
                            width: list.width;
                            game: game;
                            picked: i == root.selected;
                            acting: i == root.acting;
                            action: root.action;
                            renaming: i == root.renaming;
                            activate => {
                                root.selected = i;
                                root.launch(i);
                            }
                            point => {
                                if (root.acting < 0 && root.renaming < 0) {
                                    root.selected = i;
                                }
                            }
                            more => { root.more(i); }
                            act(which) => { root.act(i, which); }
                            renamed(name) => {
                                root.renaming = -1;
                                keys.focus();
                                root.rename(i, name);
                            }
                        }
                    }

                    if root.games.length == 0: Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.total == 0 ? "No games yet.\nAdd one with +." : "Nothing matches “" + root.query + "”.";
                        font-size: Tokens.small-size;
                        color: Tokens.dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.notice != "" ? root.notice
                        : help.hovered ? "Copy a prompt that explains Hanami to your AI"
                        : add.hovered ? "Add a game by picking its program"
                        : root.renaming >= 0 ? "enter to save  ·  esc to cancel"
                        : root.acting >= 0 ? "← → to choose  ·  enter to do it  ·  esc to go back"
                        : root.folder != "" ? "enter to play  ·  esc to go back  ·  tab for more"
                        : "type to search  ·  enter to play  ·  tab for more";
                    font-size: Tokens.small-size;
                    color: root.notice == "" ? Tokens.dim : Tokens.text;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    // Set when a newer release is out, like "0.2.0"; empty hides the item.
    in property <string> update-version;
    // Hanami opens in the tray at login.
    in property <bool> at-login;

    callback open-panel();
    callback show-panel();
    callback edit-settings();
    callback toggle-at-login();
    callback quit-app();
    callback get-update();

    icon: @image-url("../../assets/hanami-icon.svg");
    title: "Hanami";
    tooltip: "Hanami";
    clicked => { root.open-panel(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.show-panel(); }
        }
        MenuItem {
            title: "Edit settings";
            activated => { root.edit-settings(); }
        }
        MenuItem {
            title: root.at-login ? "Open at login  ✓" : "Open at login";
            activated => { root.toggle-at-login(); }
        }
        if root.update-version != "": MenuItem {
            title: "Get Hanami " + root.update-version;
            activated => { root.get-update(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit-app(); }
        }
    }
}
